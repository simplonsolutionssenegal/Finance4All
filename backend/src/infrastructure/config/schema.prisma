generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id
  name  String
  email String @unique
}

model Institution {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String
  website         String?
  geographicZones String[]
  products  Product[]
  logoUrl         String?
  status          InstitutionStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  PENDING
}
enum ProductType {
  CREDIT
  EPARGNE
  MOBILE_MONEY
  INVESTISSEMENT
  ASSURANCE
}

enum RemboursementMode {
  AGENCE
  USSD
  MOBILE
}


model Product {
  id                 String            @id @default(cuid())
  designation        String
  montantMin         Decimal           @db.Decimal(18, 2)
  montantMax         Decimal           @db.Decimal(18, 2)
  type               ProductType
  modesRemboursement RemboursementMode

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  // Zone(s) (array texte)
  zones String[] @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}