generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id
  name  String
  email String @unique
}

model Beneficiary {
  id             String @id @default(uuid())
  organizationId String
  clerkUserId    String @unique

  firstName String
  lastName  String
  email     String
  phone     String?

  status            BeneficiaryStatus  @default(ACTIVE)
  progressPercent   Int                @default(0)
  moduleAssignments ModuleAssignment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([status])
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
}

model Institution {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String
  website         String?
  geographicZones String[]
  logoUrl         String?
  type            InstitutionType   @default(ETABLISSEMENT_MONNAIE_ELECTRONIQUE)
  pays            Country           @default(SENEGAL)
  status          InstitutionStatus @default(PENDING)
  services        Service[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Service {
  id                   String      @id @default(uuid())
  name                 String
  longName             String
  type                 TypeService
  frais                Json
  conditionAccess      String[]
  plafonds             String[]
  infrastructureAccess String[]
  montantMin           Float?
  montantMax           Float?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum TypeService {
  PAIEMENT_MARCHAND
  ACHAT_CREDIT
  PAIEMENT_FACTURES
  DEPOT_SIMPLE
  DEPOT_RETRAIT_SIMPLE
  RETRAIT_SIMPLE
  TRANSFERT_ARGENT
  BANQUE_WALLET
  WALLET_BANQUE
  EPARGNE
  CREDIT
  ASSURANCE
  AUTRES
}

enum InstitutionType {
  ETABLISSEMENT_MONNAIE_ELECTRONIQUE
  PORTEFEUILLE_NUMERIQUE
  SERVICE_PAIEMENT_ELECTRONIQUE
  BANQUE_NUMERIQUE
  SERVICE_FINANCIER_DECENTRALISE
  SERVICE_FINANCEMENT_PARTICIPATIF
  SERVICE_INVESTISSEMENT
  SERVICE_GESTION_FINANCIERE
  SERVICE_ASSURANCE_NUMERIQUE
}

enum Country {
  SENEGAL
  CAMEROUN
}

model Module {
  id          String @id @default(uuid())
  title       String @db.VarChar(200)
  description String @db.Text
  thematics   String @unique @db.VarChar(200)

  imageMediaId String?
  imageMedia   Media?             @relation("ModuleImage", fields: [imageMediaId], references: [id])
  assignments  ModuleAssignment[]

  difficultyLevel   DifficultyLevel
  estimatedDuration Float
  status            ModuleStatus    @default(DRAFT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([difficultyLevel])
  @@index([createdAt])
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Media {
  id           String    @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  type         MediaType
  size         Int
  bucket       String
  path         String
  metadata     Json?
  isTemporary  Boolean   @default(false)
  expiresAt    DateTime?
  moduleImage  Module[]  @relation("ModuleImage")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([createdAt])
  @@index([isTemporary, expiresAt])
}

enum MediaType {
  VIDEO
  PDF
  AUDIO
  IMAGE
}

// ==================== Assignation  module====================
enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REMOVED
}

model ModuleAssignment {
  id String @id @default(uuid())

  beneficiaryId String
  moduleId      String

  status   AssignmentStatus @default(ASSIGNED)
  progress Int              @default(0)

  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  removedAt   DateTime?

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryId, moduleId])
  @@index([beneficiaryId])
  @@index([moduleId])
  @@index([status])
}

// ==================== STREAMING ====================

enum TranscodingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StreamQuality {
  Q360P
  Q480P
  Q720P
  Q1080P
  AUDIO_LOW
  AUDIO_MEDIUM
  AUDIO_HIGH
}

model HlsVariant {
  id              String        @id @default(uuid())
  mediaId         String
  quality         StreamQuality
  bandwidth       Int
  resolution      String?
  codecs          String
  playlistPath    String
  segmentPrefix   String
  segmentCount    Int           @default(0)
  segmentDuration Float         @default(10.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mediaId, quality])
  @@index([mediaId])
}

model TranscodingJob {
  id           String            @id @default(uuid())
  mediaId      String            @unique
  status       TranscodingStatus @default(PENDING)
  progress     Float             @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([mediaId])
}

model MediaProgress {
  id      String @id @default(uuid())
  userId  String
  mediaId String

  currentPosition Float   @default(0)
  duration        Float   @default(0)
  completionRate  Float   @default(0)
  isCompleted     Boolean @default(false)

  lastWatchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
  @@index([userId, lastWatchedAt])
}

model StreamToken {
  id        String   @id @default(uuid())
  userId    String
  mediaId   String
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
  @@index([mediaId, userId])
  @@index([expiresAt])
}
