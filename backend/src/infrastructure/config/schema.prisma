generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id
  name  String
  email String @unique
}

enum ProductType {
  CREDIT
  EPARGNE
  MOBILE_MONEY
  INVESTISSEMENT
  ASSURANCE
}

enum RemboursementMode {
  AGENCE
  USSD
  MOBILE
}

model Institution {
  id        String   @id @default(cuid())
  name      String   @unique
  avatar    String
  // ancien: institutionServices
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                 String            @id @default(cuid())
  designation        String
  montantMin         Decimal           @db.Decimal(18, 2)
  montantMax         Decimal           @db.Decimal(18, 2)
  type               ProductType
  modesRemboursement RemboursementMode

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  // Zone(s) (array texte)
  zones String[] @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}
