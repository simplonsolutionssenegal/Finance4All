generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id
  name  String
  email String @unique
}


enum InstitutionServiceType {
  CREDIT
  EPARGNE
  MOBILE_MONEY
  INVESTISSEMENT
  ASSURANCE
}

enum RemboursementMode {
  AGENCE
  USSD
  MOBILE
}

model Institution {
  id                  String                @id @default(cuid())
  name                String                @unique
  avatar              String
  institutionServices InstitutionService[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model InstitutionService {
  id                 String                 @id @default(cuid())
  designation        String
  montantMin         Decimal                @db.Decimal(18, 2)
  montantMax         Decimal                @db.Decimal(18, 2)
  type               InstitutionServiceType
  modesRemboursement RemboursementMode

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  // Zone(s) stockées en BDD sous forme de tableau (invariant: 1 élément)
  zones String[] @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
}
