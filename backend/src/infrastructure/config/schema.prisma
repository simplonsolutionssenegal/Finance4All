generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIF
  EN_ATTENTE
  INACTIF
  SUSPENDU
}



model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]   // Un rôle peut avoir plusieurs utilisateurs
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique @default("temp_username") // <- temporaire
  firstName String?
  lastName  String?
  avatar    String?
  password  String
  status   UserStatus    @default(ACTIF)
  isActive  Boolean  @default(true)
  lastLoginAt  DateTime  @default(now())
  roleId    Int
  organisationId Int?
  role      Role     @relation(fields: [roleId], references: [id])
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}


model Organisation {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    String?
  users     User[]
}
