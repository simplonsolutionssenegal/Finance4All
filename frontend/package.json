{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096 --no-node-snapshot' npx next dev",
    "dev:turbo": "NODE_OPTIONS='--max-old-space-size=4096 --no-node-snapshot' node --trace-warnings node_modules/.bin/next dev --turbopack",
    "dev:safe": "NODE_OPTIONS='--max-old-space-size=4096 --no-node-snapshot --openssl-legacy-provider' node --trace-warnings node_modules/.bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:format": "npm run lint:fix && npm run format",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
